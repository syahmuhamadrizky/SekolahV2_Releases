# ========================================================
# DAPOY SCHOOLS - PRODUCTION ENVIRONMENT CONFIGURATION
# ========================================================

# Server Port (Default: 5001 atau disesuaikan dengan hosting / cPanel)
PORT=5001
NODE_ENV=production

# Database MySQL Configuration (WAJIB DIISI)
DB_HOST=localhost
DB_NAME=nama_database
DB_USER=user_database
DB_PASSWORD=password_database

# JWT Secret untuk Autentikasi Keamanan (Ubah ke string acak panjang)
JWT_SECRET=ganti_dengan_random_secret_key_yang_sangat_panjang_dan_aman_123456789

# Lisensi Aplikasi Dapoy Hub (Bila sudah memiliki key aktivasi)
LICENSE_KEY=

# Google Gemini API Key (Opsional untuk fitur AI)
GEMINI_API_KEY=
